# Sao chép thành biến môi trường trước khi chạy (PowerShell: $env:DATABASE_URL = "...")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flight_booking
# Bắt buộc đổi khi triển khai thật: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-key-change-me-in-production
# production: server từ chối chạy nếu vẫn dùng SECRET_KEY mặc định
APP_ENV=development
# Gửi email thật (để trống thì email lưu vào backend/outbox/*.html). Gmail cần "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
